# Base URL for the REST API (no trailing slash)
VITE_API_BASE_URL=/api/v1
# WebSocket endpoint for live events
VITE_WS_URL=ws://localhost:5173/ws
# true = MSW mocks + seeded simulator; false = real backend
VITE_USE_MOCKS=true
# Simulator seed (mock mode only)
VITE_SIM_SEED=4242
# Display time zone
VITE_DISPLAY_TZ=Africa/Lagos
